---
import { SITE_CONFIG } from '../content/config/site.config';

const year = new Date().getFullYear();
---

<footer class="cf-footer">
  <div class="cf-footer-inner">
    <div class="cf-footer-main">
      <div class="cf-footer-container">
        <div class="cf-footer-grid">

          <div class="cf-footer-col">
            <h3>PRODUCTS</h3>
            <ul>
              <li><a href="/products/artemia-cysts/">Artemia Cysts</a></li>
              <li><a href="/products/decapsulated-eggs/">Decapsulated Eggs</a></li>
            </ul>
          </div>

          <div class="cf-footer-col">
            <h3>APPLICATIONS</h3>
            <ul>
              <li><a href="/application-shrimp-hatchery/">Shrimp Hatchery</a></li>
              <li><a href="/applications/fish-fry/">Fish Fry</a></li>
              <li><a href="/applications/crab-larvae/">Crab Larvae</a></li>
            </ul>
          </div>

          <div class="cf-footer-col">
            <h3>COMPANY</h3>
            <ul>
              <li><a href="/about/">About Us</a></li>
              <li><a href="/products/">Products</a></li>
              <li><a href="/applications/">Applications</a></li>
              <li><a href="/about/quality-control/">Quality &amp; Supply Assurance</a></li>
              <li><a href="/about/processing-facility/">Processing Facility</a></li>
              <li><a href="/about/cold-storage/">Cold Storage</a></li>
              <li><a href="/about/packaging/">Packaging</a></li>
              <li><a href="/about/global-supply/">Global Supply</a></li>
              <li><a href="/news/">News</a></li>
              <li><a href="/faq/">FAQ</a></li>
              <li><a href="/blog/">Blog</a></li>
              <li><a href="/contact/">Contact</a></li>
            </ul>
          </div>

          <div class="cf-footer-col cf-footer-contact">
            <h3>CONTACT</h3>
            <ul>
              <li>
                <span class="cf-footer-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M12 2.25C8.14 2.25 5 5.39 5 9.25c0 5.35 6.24 11.93 6.5 12.2a.7.7 0 0 0 1 0c.26-.27 6.5-6.85 6.5-12.2 0-3.86-3.14-7-7-7Zm0 10.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4Z"/></svg>
                </span>
                <span>Fengjiawan Fishery Industrial Park<br>No. 129, Huiwen Town, Wenchang, Hainan</span>
              </li>
              <li>
                <span class="cf-footer-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M20.5 4h-17A2.5 2.5 0 0 0 1 6.5v11A2.5 2.5 0 0 0 3.5 20h17a2.5 2.5 0 0 0 2.5-2.5v-11A2.5 2.5 0 0 0 20.5 4Zm-.34 3.1-7.18 5.58a1.58 1.58 0 0 1-1.96 0L3.84 7.1a.75.75 0 0 1 .92-1.18L12 11.55l7.24-5.63a.75.75 0 0 1 .92 1.18Z"/></svg>
                </span>
                <a href={`mailto:${SITE_CONFIG.contact.email}`}>{SITE_CONFIG.contact.email}</a>
              </li>
              <li>
                <span class="cf-footer-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2a1 1 0 0 1 1.01-.24c1.11.37 2.31.56 3.58.56a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.27.19 2.47.56 3.58a1 1 0 0 1-.24 1.01l-2.2 2.2Z"/></svg>
                </span>
                <a href={`tel:${SITE_CONFIG.contact.phone.replaceAll(' ', '')}`}>{SITE_CONFIG.contact.phone}</a>
              </li>
            </ul>
            <div class="cf-footer-social">
              <a href={SITE_CONFIG.social.youtube} target="_blank" rel="noopener" aria-label="YouTube" class="cf-social-link">
                <svg viewBox="0 0 24 24"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31.2 31.2 0 0 0 0 12a31.2 31.2 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31.2 31.2 0 0 0 24 12a31.2 31.2 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.2 3.6-6.2 3.6Z"/></svg>
              </a>
            </div>
          </div>


        </div>
      </div>
    </div>

    <div class="cf-footer-bottom">
      <div class="cf-footer-container cf-footer-bottom-inner">
        <p>&copy; {year} CIDE FISHERY. All rights reserved.</p>
        <button class="cf-back-top" type="button" data-cf-back-top>BACK TO TOP &uarr;</button>
      </div>
    </div>

    <div class="cf-footer-brand-wrap">
      <img src="/images/footer-logo.webp" alt="CIDE FISHERY Footer Logo" class="cf-footer-brand-img">
    </div>
  </div>
</footer>

<style>
.cf-footer {
  width: 100%;
  font-family: var(--font-family);
  overflow: hidden;
}

.cf-footer,
.cf-footer * {
  box-sizing: border-box;
}

.cf-footer-main {
  padding: clamp(60px, 7vw, 110px) 0;
  background:
    radial-gradient(circle at 12% 16%, rgba(30,95,168,0.18), transparent 32%),
    radial-gradient(circle at 88% 88%, rgba(53,183,216,0.10), transparent 36%),
    linear-gradient(135deg, #0B1F33, #061524);
}

.cf-footer-container {
  width: 90%;
  max-width: 1320px;
  margin: 0 auto;
}

.cf-footer-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1.5fr;
  gap: clamp(34px, 5vw, 90px);
}

.cf-footer-col h3 {
  margin: 0 0 24px;
  font-size: clamp(15px, 1vw, 17px);
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #ffffff;
}

.cf-footer-col ul {
  list-style: none;
  margin: 0;
  padding: 0;
}

.cf-footer-col li {
  margin: 0 0 14px;
  color: rgba(255, 255, 255, 0.64);
  font-size: clamp(15px, 1vw, 17px);
  line-height: 1.45;
}

.cf-footer-col a {
  color: rgba(255, 255, 255, 0.64);
  text-decoration: none;
  transition: color 0.22s ease;
}

.cf-footer-col a:hover {
  color: #E6B36A;
}

.cf-footer-contact li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
}

.cf-footer-icon {
  flex: 0 0 24px;
  width: 24px;
  height: 24px;
  color: #E6B36A;
  opacity: 0.85;
}

.cf-footer-icon svg {
  width: 100%;
  height: 100%;
  display: block;
  fill: currentColor;
}


.cf-footer-social {
  display: flex;
  gap: 16px;
  margin-top: 24px;
}

.cf-social-link {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.10);
  color: rgba(255, 255, 255, 0.70);
  transition: background 0.22s ease, color 0.22s ease, transform 0.22s ease;
}

.cf-social-link svg {
  width: 20px;
  height: 20px;
  fill: currentColor;
}

.cf-social-link:hover {
  background: #E6B36A;
  color: #0B1F33;
  transform: translateY(-2px);
}
.cf-footer-bottom {
  border-top: 1px solid rgba(255, 255, 255, 0.10);
  background: #061524;
}

.cf-footer-bottom-inner {
  min-height: 74px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  padding: 18px 0;
}

.cf-footer-bottom p {
  margin: 0;
  font-size: 15px;
  line-height: 1.4;
  font-weight: 600;
  color: #f9fafb;
}

.cf-back-top {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 0;
  padding: 0;
  background: transparent;
  color: #f9fafb;
  font-size: 14px;
  line-height: 1;
  font-weight: 800;
  letter-spacing: 0.04em;
  cursor: pointer;
  transition: color 0.22s ease, transform 0.22s ease;
}

.cf-back-top:hover {
  color: #E6B36A;
  transform: translateY(-2px);
}

.cf-footer-brand-wrap {
  background: #F5F8FC;
  padding: clamp(34px, 5vw, 76px) 0;
}

.cf-footer-brand-img {
  width: 90%;
  max-width: 1760px;
  height: auto;
  display: block;
  margin: 0 auto;
}

@media (max-width: 1024px) {
  .cf-footer-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 767px) {
  .cf-footer-container {
    width: 90%;
  }

  .cf-footer-grid {
    grid-template-columns: 1fr;
    gap: 36px;
  }

  .cf-footer-bottom-inner {
    flex-direction: column;
    align-items: flex-start;
  }
}
</style>

<script is:inline>
(function () {
  var btn = document.querySelector("[data-cf-back-top]");
  if (btn) {
    btn.addEventListener("click", function () {
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
  }
})();
</script>
