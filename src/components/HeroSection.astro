---

---

<section class="cf-home-banner" id="cfHomeBanner">

  <svg class="cf-svg-filter" width="0" height="0" aria-hidden="true" focusable="false">
    <filter id="cfHomeBannerOceanWaveFilter" x="-15%" y="-15%" width="130%" height="130%">
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.012 0.045"
        numOctaves="2"
        seed="8"
        result="oceanNoise">
        <animate
          attributeName="baseFrequency"
          dur="7s"
          values="0.012 0.045; 0.020 0.070; 0.014 0.055; 0.012 0.045"
          repeatCount="indefinite" />
      </feTurbulence>

      <feDisplacementMap
        in="SourceGraphic"
        in2="oceanNoise"
        scale="14"
        xChannelSelector="R"
        yChannelSelector="G">
        <animate
          attributeName="scale"
          dur="5.5s"
          values="8; 14; 11; 16; 8"
          repeatCount="indefinite" />
      </feDisplacementMap>
    </filter>
  </svg>

  <div class="cf-banner-slides">
    <div class="cf-banner-slide active">
      <img src="/images/banner-01.avif" alt="CIDE FISHERY artemia cysts supplier for hatchery aquaculture" width="1920" height="780">
    </div>
  </div>

  <div class="cf-banner-overlay"></div>
  <div class="cf-ocean-ripple"></div>
  <div class="cf-switch-wave"></div>

  <div class="cf-banner-text">
    <div class="cf-banner-text-item active">
      <p class="cf-banner-subtitle">CIDE FISHERY | Artemia Cysts Supplier</p>
      <h1>China's Largest Artemia Cysts Production Company</h1>
      <p class="cf-banner-lead">Automated Artemia cyst production, batch documentation and export packaging support for hatcheries, importers and distributors.</p>
      <div class="cf-proof-grid">
        <span>Main Product: Artemia Cysts</span>
        <span>Production Base: China's largest automated Artemia cyst facility</span>
        <span>Trust: 30+ years of global hatchery cooperation</span>
        <span>Capability: automated manufacturing process</span>
      </div>
      <div class="cf-banner-btn">
        <a href="/contact/">Request Current Batch Quote <span>&#8594;</span></a>
      </div>
      <div class="cf-hero-evidence" aria-label="CIDE FISHERY buyer evidence">
        <a href="/products/artemia-cysts/">
          <img src="/images/products/cide-premium-artemia-cysts-can.jpg" alt="CIDE premium Artemia cysts product can" width="425" height="567" loading="eager">
          <span>Products &amp; packaging</span>
        </a>
        <a href="/about/quality-control/">
          <img src="/images/products/artemia-hatching-test-tubes.avif" alt="Artemia cysts hatching test quality control tubes" width="1448" height="1086" loading="eager">
          <span>Batch QC proof</span>
        </a>
        <a href="/about/processing-facility/">
          <img src="/images/company/artemia-cyst-processing-equipment-tanks.avif" alt="CIDE FISHERY Artemia cyst processing equipment tanks" width="1200" height="800" loading="eager">
          <span>Factory capability</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
#cfHomeBanner.cf-home-banner {
  position: relative;
  width: 100vw;
  height: 780px;
  margin-left: calc(50% - 50vw);
  overflow: hidden;
  clip-path: inset(0);
  contain: layout paint;
  background: #0B1F33;
  font-family: var(--font-family);
  isolation: isolate;
  z-index: 1;
}

#cfHomeBanner .cf-svg-filter {
  position: absolute;
  width: 0;
  height: 0;
  overflow: hidden;
  left: -9999px;
  top: -9999px;
  pointer-events: none;
}

#cfHomeBanner .cf-banner-slides,
#cfHomeBanner .cf-banner-slide {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

#cfHomeBanner .cf-banner-slide {
  opacity: 1;
  transform: scale(1);
  z-index: 1;
}

#cfHomeBanner .cf-banner-slide.active {
  opacity: 1;
  transform: scale(1);
  z-index: 2;
}

#cfHomeBanner .cf-banner-slide img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

#cfHomeBanner .cf-banner-slide.active img {
  filter: url(#cfHomeBannerOceanWaveFilter);
  animation: cfHomeBannerOceanImageMove 8s ease-in-out infinite;
  transform-origin: center center;
}

@keyframes cfHomeBannerOceanImageMove {
  0% {
    transform: scale(1.06) translate3d(0, 0, 0);
  }
  25% {
    transform: scale(1.07) translate3d(-0.5%, 0.25%, 0);
  }
  50% {
    transform: scale(1.065) translate3d(0.5%, -0.2%, 0);
  }
  75% {
    transform: scale(1.075) translate3d(-0.25%, -0.35%, 0);
  }
  100% {
    transform: scale(1.06) translate3d(0, 0, 0);
  }
}

#cfHomeBanner .cf-banner-overlay {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none;
  background:
    linear-gradient(90deg, rgba(11,31,51,0.88) 0%, rgba(11,31,51,0.60) 40%, rgba(0,0,0,0.18) 100%),
    radial-gradient(circle at 22% 48%, rgba(30,95,168,0.24), transparent 36%);
}

#cfHomeBanner .cf-ocean-ripple {
  position: absolute;
  inset: -10%;
  z-index: 4;
  pointer-events: none;
  opacity: 0.18;
  mix-blend-mode: screen;
  background:
    radial-gradient(ellipse at 30% 42%, rgba(255,255,255,0.14), transparent 34%),
    radial-gradient(ellipse at 72% 58%, rgba(53,183,216,0.14), transparent 36%),
    radial-gradient(ellipse at center, rgba(255,255,255,0.08), transparent 42%);
  filter: blur(10px);
  animation: cfHomeBannerOceanRippleMove 11s ease-in-out infinite;
}

@keyframes cfHomeBannerOceanRippleMove {
  0% {
    transform: translate3d(-2%, 1%, 0) scale(1.03);
  }
  50% {
    transform: translate3d(3%, -2%, 0) scale(1.1);
  }
  100% {
    transform: translate3d(-2%, 1%, 0) scale(1.03);
  }
}

#cfHomeBanner .cf-switch-wave {
  display: none;
}

#cfHomeBanner .cf-banner-text {
  position: absolute;
  z-index: 5;
  left: 8%;
  top: 45%;
  transform: translateY(-50%);
  width: min(84vw, 1120px);
  max-width: 1120px;
  color: #fff;
}

#cfHomeBanner .cf-banner-text-item {
  display: none;
  animation: cfHomeBannerTextUp 0.9s ease both;
}

#cfHomeBanner .cf-banner-text-item.active {
  display: block;
}

#cfHomeBanner .cf-banner-subtitle {
  margin: 0 0 18px;
  font-size: 24px;
  line-height: 1.2;
  font-weight: 500;
  letter-spacing: 0.5px;
  color: #ffffff;
}

#cfHomeBanner .cf-banner-lead {
  max-width: 680px;
  margin: 16px 0 0;
  color: rgba(255,255,255,0.82);
  font-size: 18px;
  line-height: 1.5;
}

#cfHomeBanner .cf-hero-evidence {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
  max-width: 760px;
  margin-top: 20px;
}

#cfHomeBanner .cf-hero-evidence a {
  display: grid;
  grid-template-columns: 66px minmax(0, 1fr);
  align-items: center;
  gap: 12px;
  min-height: 74px;
  padding: 10px;
  border: 1px solid rgba(255,255,255,0.22);
  background: rgba(255,255,255,0.12);
  color: #ffffff;
  text-decoration: none;
  backdrop-filter: blur(10px);
}

#cfHomeBanner .cf-hero-evidence img {
  width: 66px;
  height: 56px;
  object-fit: cover;
  display: block;
  background: rgba(255,255,255,0.10);
}

#cfHomeBanner .cf-hero-evidence span {
  color: #ffffff;
  font-size: 13px;
  font-weight: 800;
  line-height: 1.25;
}

#cfHomeBanner .cf-proof-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  max-width: 760px;
  margin-top: 20px;
}

#cfHomeBanner .cf-proof-grid span {
  display: block;
  min-height: 58px;
  padding: 12px 14px;
  border-left: 3px solid #E6B36A;
  background: rgba(255,255,255,0.10);
  color: #ffffff;
  font-size: 14px;
  font-weight: 700;
  line-height: 1.35;
  backdrop-filter: blur(8px);
}

#cfHomeBanner .cf-banner-text h1,
#cfHomeBanner .cf-banner-text h2 {
  margin: 0;
  font-size: 50px;
  line-height: 1.12;
  font-weight: 700;
  max-width: 820px;
  color: #ffffff;
}

#cfHomeBanner .cf-banner-btn {
  margin-top: 24px;
}

#cfHomeBanner .cf-banner-btn a {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 16px 34px;
  border-radius: 0;
  background: #E6B36A;
  color: #0B1F33;
  text-decoration: none;
  font-size: 15px;
  font-weight: 700;
  letter-spacing: 0.5px;
  transition: all 0.3s ease;
}

#cfHomeBanner .cf-banner-btn a:hover {
  background: #ffffff;
  color: #0B1F33;
}

@keyframes cfHomeBannerTextUp {
  from {
    opacity: 0;
    transform: translateY(35px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 1024px) {
  #cfHomeBanner.cf-home-banner {
    height: 680px;
  }

  #cfHomeBanner .cf-banner-text {
    width: 82%;
    left: 7%;
  }

  #cfHomeBanner .cf-banner-text h1,
  #cfHomeBanner .cf-banner-text h2 {
    font-size: 44px;
  }

  #cfHomeBanner .cf-banner-subtitle {
    font-size: 21px;
  }
}

@media (max-width: 767px) {
  #cfHomeBanner.cf-home-banner {
    height: 720px;
  }

  #cfHomeBanner .cf-banner-text {
    left: 6%;
    right: 6%;
    width: auto;
    top: 52%;
  }

  #cfHomeBanner .cf-banner-text h1,
  #cfHomeBanner .cf-banner-text h2 {
    font-size: 28px;
    line-height: 1.2;
  }

  #cfHomeBanner .cf-banner-subtitle {
    font-size: 18px;
  }

  #cfHomeBanner .cf-banner-lead {
    font-size: 15px;
  }

  #cfHomeBanner .cf-proof-grid {
    display: none;
  }

  #cfHomeBanner .cf-hero-evidence {
    grid-template-columns: 1fr;
    gap: 8px;
    margin-top: 16px;
  }

  #cfHomeBanner .cf-hero-evidence a {
    grid-template-columns: 52px minmax(0, 1fr);
    min-height: 58px;
    padding: 8px;
  }

  #cfHomeBanner .cf-hero-evidence img {
    width: 52px;
    height: 44px;
  }

  #cfHomeBanner .cf-banner-btn a {
    padding: 13px 24px;
    font-size: 13px;
  }

  #cfHomeBanner .cf-banner-arrow {
    display: none;
  }

  #cfHomeBanner .cf-ocean-ripple {
    opacity: 0.12;
  }
}
</style>
