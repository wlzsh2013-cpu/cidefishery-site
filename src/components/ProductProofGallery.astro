---
export interface ProofItem {
  title: string;
  description?: string;
  image: string;
  alt: string;
}

export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: ProofItem[];
}

const {
  eyebrow = 'Certificates',
  title,
  description,
  items,
} = Astro.props;
---

<section class="section certificate-section">
  <div class="container certificate-layout">
    <div class="certificate-head">
      <div class="section-head">
        <span class="eyebrow">{eyebrow}</span>
        <h2>{title}</h2>
        {description && <p>{description}</p>}
      </div>

      <div class="certificate-panel" aria-label="Certificate availability note">
        <span>Certified supplier profile</span>
        <strong>Documented systems for quality, safety and export supply.</strong>
        <p>These certificates show the management systems, processing controls and company qualifications behind CIDE FISHERY supply.</p>
      </div>
    </div>

    <div class="certificate-grid">
      {items.map((item) => (
        <article class="certificate-card">
          <div class="certificate-media">
            <img src={item.image} alt={item.alt} width="520" height="680" loading="lazy" />
          </div>
          <div class="certificate-copy">
            <span class="certificate-tag">Certification</span>
            <h3>{item.title}</h3>
            {item.description && <p>{item.description}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .certificate-section {
    background:
      linear-gradient(180deg, #f7fbfd 0%, var(--color-white) 58%, #f8fbfd 100%);
  }

  .certificate-layout {
    display: grid;
    gap: 32px;
  }

  .certificate-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    gap: 40px;
    align-items: end;
  }

  .section-head {
    max-width: 820px;
    margin-bottom: 0;
  }

  .eyebrow {
    display: inline-block;
    color: var(--color-brand-blue);
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .section-head h2 {
    margin-bottom: 20px;
  }

  .section-head p {
    max-width: 760px;
  }

  .certificate-panel {
    position: relative;
    overflow: hidden;
    padding: 26px;
    border-radius: var(--border-radius);
    background:
      linear-gradient(135deg, rgba(53,183,216,0.16), rgba(230,179,106,0.16)),
      var(--color-primary);
    color: var(--color-white);
  }

  .certificate-panel::after {
    position: absolute;
    top: 0;
    right: 0;
    width: 86px;
    height: 100%;
    background: linear-gradient(180deg, rgba(230,179,106,0.85), rgba(53,183,216,0.25));
    content: '';
  }

  .certificate-panel span,
  .certificate-panel strong,
  .certificate-panel p {
    position: relative;
    z-index: 1;
  }

  .certificate-panel span {
    display: block;
    margin-bottom: 10px;
    color: var(--color-champagne-gold);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .certificate-panel strong {
    display: block;
    max-width: 260px;
    font-size: 22px;
    line-height: 1.25;
  }

  .certificate-panel p {
    max-width: 280px;
    margin: 12px 0 0;
    color: rgba(255,255,255,0.74);
    font-size: var(--fs-small);
    line-height: 1.58;
  }

  .certificate-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 18px;
  }

  .certificate-card {
    position: relative;
    display: grid;
    grid-column: span 2;
    overflow: hidden;
    border: 1px solid rgba(11,31,51,0.10);
    border-radius: var(--border-radius);
    background: var(--color-white);
    box-shadow: 0 16px 38px rgba(11,31,51,0.06);
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }

  .certificate-card:nth-child(-n+2) {
    grid-column: span 3;
    grid-template-columns: minmax(180px, 0.84fr) minmax(0, 1fr);
    min-height: 330px;
  }

  .certificate-card::before {
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--color-brand-blue), var(--color-tech-cyan), var(--color-champagne-gold));
    content: '';
  }

  .certificate-card:hover {
    transform: translateY(-3px);
    border-color: rgba(30,95,168,0.34);
    box-shadow: 0 24px 48px rgba(11,31,51,0.10);
  }

  .certificate-media {
    display: grid;
    align-items: center;
    padding: 20px;
    background:
      linear-gradient(135deg, rgba(30,95,168,0.08), rgba(53,183,216,0.08)),
      #eef5f9;
  }

  .certificate-media img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: contain;
    background: #ffffff;
    border: 1px solid rgba(11,31,51,0.08);
    box-shadow: 0 14px 26px rgba(11,31,51,0.12);
  }

  .certificate-copy {
    display: flex;
    min-height: 178px;
    padding: 22px;
    flex-direction: column;
    justify-content: center;
  }

  .certificate-tag {
    align-self: flex-start;
    margin-bottom: 12px;
    padding: 6px 10px;
    border: 1px solid rgba(230,179,106,0.45);
    border-radius: 999px;
    background: rgba(230,179,106,0.12);
    color: #7d5520;
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
  }

  .certificate-copy h3 {
    margin: 0 0 10px;
    color: var(--color-primary);
    font-size: 20px;
    font-weight: 800;
    line-height: 1.35;
  }

  .certificate-copy p {
    margin: 0;
    color: rgba(16,32,48,0.72);
    font-size: 15px;
    line-height: 1.62;
  }

  @media (max-width: 1024px) {
    .certificate-head {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .certificate-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .certificate-card,
    .certificate-card:nth-child(-n+2) {
      grid-column: span 1;
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .certificate-panel {
      padding: 22px;
    }

    .certificate-panel strong,
    .certificate-panel p {
      max-width: none;
    }

    .certificate-grid {
      grid-template-columns: 1fr;
    }

    .certificate-copy {
      min-height: auto;
      padding: 20px;
    }
  }
</style>
