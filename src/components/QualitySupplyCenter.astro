---
const proofItems = [
  {
    title: 'Batch Quality Control',
    text: 'Hatching rate review, purity checks and practical batch records for current procurement discussions.',
    href: '/about/quality-control/',
  },
  {
    title: 'Processing Facility',
    text: 'Automated processing, grading and controlled handling from raw material intake to packed product.',
    href: '/about/processing-facility/',
  },
  {
    title: 'Cold-Chain Storage',
    text: 'Temperature-managed inventory and export preparation to protect biological performance before shipment.',
    href: '/about/cold-storage/',
  },
  {
    title: 'Packaging Documents',
    text: 'Vacuum cans, foil bags, drums, carton plans and private-label options matched to buyer volume.',
    href: '/about/packaging/',
  },
];
---

<section class="quality-center section">
  <div class="container quality-center-grid">
    <div class="quality-copy">
      <span class="eyebrow">Quality &amp; Supply Assurance</span>
      <h2>Check Batch Data, Factory Proof and Export Documents Before You Order</h2>
      <p>Before approving samples or repeat supply, you can request the current batch analysis, processing records, cold-chain information, packaging details and export document support you need for internal review.</p>
      <div class="quality-actions">
        <a href="/contact/">Request Current Batch Files</a>
        <a href="/about/quality-control/">Review QC Capability</a>
      </div>
    </div>
    <div class="quality-list">
      {proofItems.map((item) => (
        <a href={item.href} class="quality-item">
          <strong>{item.title}</strong>
          <span>{item.text}</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .quality-center {
    background: var(--color-white);
  }

  .quality-center-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }

  .quality-copy h2 {
    max-width: 760px;
    margin-bottom: 18px;
  }

  .quality-copy p {
    max-width: 650px;
    color: rgba(16, 32, 48, 0.72);
    font-size: 17px;
    line-height: 1.65;
  }

  .quality-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 28px;
  }

  .quality-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 12px 20px;
    border: 1px solid var(--color-champagne-gold);
    color: var(--color-primary);
    font-weight: 800;
    text-decoration: none;
  }

  .quality-actions a:first-child {
    background: var(--color-champagne-gold);
  }

  .quality-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .quality-item {
    display: grid;
    align-content: start;
    gap: 10px;
    min-height: 172px;
    padding: 24px;
    border: 1px solid rgba(11, 31, 51, 0.10);
    border-top: 4px solid var(--color-champagne-gold);
    border-radius: 8px;
    background: #F5F8FC;
    color: var(--color-text);
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .quality-item:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px rgba(11, 31, 51, 0.10);
  }

  .quality-item strong {
    color: var(--color-primary);
    font-size: 20px;
  }

  .quality-item span {
    color: rgba(16, 32, 48, 0.70);
    line-height: 1.55;
  }

  @media (max-width: 1024px) {
    .quality-center-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .quality-list {
      grid-template-columns: 1fr;
    }
  }
</style>
