---
const productCards = [
  {
    title: 'Artemia Cysts',
    href: '/products/artemia-cysts/',
    image: '/images/products/cide-premium-artemia-cysts-can.jpg',
    alt: 'CIDE premium Artemia cysts can with branded packaging',
    width: 425,
    height: 567,
    description: 'Natural Artemia cysts in 425g / 15oz cans for shrimp hatcheries, fish fry, crab larvae programs and distributors.',
    linkText: 'View Artemia Cysts',
  },
  {
    title: 'Decapsulated Brine Shrimp Eggs',
    href: '/products/decapsulated-eggs/',
    image: '/images/products/decapsulated-artemia-cysts-microscope.avif',
    alt: 'Microscope view of decapsulated Artemia cysts',
    width: 1448,
    height: 1086,
    description: 'Shell-free brine shrimp eggs for direct feeding programs that need cleaner tanks and lower hatchery labor.',
    linkText: 'View Decapsulated Eggs',
  },
  {
    title: 'Custom OEM Supply',
    href: '/products/bulk-artemia-cysts/',
    image: '/images/products/cide-aqua-gold-artemia-cysts-can.jpg',
    alt: 'AQUA GOLD Artemia cysts 425g can packaging',
    width: 425,
    height: 567,
    description: 'Private-label cans, buyer-specific packaging, carton planning and repeat export supply for distributors.',
    linkText: 'Plan OEM Supply',
  },
];
---

<section class="gp-cc-section" data-gp-hscroll>
  <div class="gp-cc-sticky">
    <div class="gp-cc-header">
      <h2>Artemia Cysts Products for Aquaculture</h2>
    </div>
    <div class="gp-cc-viewport">
      <div class="gp-cc-track">
        {productCards.map((card) => (
          <article class="gp-cc-card">
            <div class="gp-cc-media">
              <img src={card.image} alt={card.alt} width={card.width} height={card.height} loading="lazy">
            </div>
            <div class="gp-cc-content">
              <h3>{card.title}</h3>
              <p>{card.description}</p>
              <div class="gp-cc-link"><a href={card.href}>{card.linkText} <span>&rarr;</span></a></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
.gp-cc-section {
  --gp-bg: #F5F8FC;
  --gp-text: #102030;
  --gp-muted: rgba(16,32,48,0.65);
  --gp-card-bg: #fff;
  --gp-border: rgba(11,31,51,0.08);
  --gp-radius: 8px;
  --gp-gap: clamp(22px,3vw,36px);
  --gp-card-width: min(60vw,580px);
  --gp-side-padding: max(24px,calc((100vw - 1200px)/2 + 24px));
  position: relative;
  background: var(--gp-bg);
  color: var(--gp-text);
  overflow: visible;
  font-family: var(--font-family);
}
.gp-cc-sticky {
  position: sticky;
  top: 72px;
  height: auto;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  gap: clamp(30px, 5vh, 54px);
  padding: clamp(34px,4vh,52px) 0 clamp(12px,1.6vh,22px);
  box-sizing: border-box;
}
.gp-cc-header { padding: 0 var(--gp-side-padding); }
.gp-cc-header h2 { margin: 0; max-width: 980px; font-size: clamp(34px,4.6vw,48px); line-height: 1.08; font-weight: 800; color: var(--color-h2); }
.gp-cc-viewport { width: 100%; overflow: visible; }
.gp-cc-track { display: flex; gap: var(--gp-gap); padding: 0 var(--gp-side-padding); will-change: transform; transform: translate3d(0,0,0); }
.gp-cc-card {
  flex: 0 0 var(--gp-card-width);
  min-height: clamp(500px,58vh,640px);
  background: var(--gp-card-bg);
  border: 1px solid var(--gp-border);
  border-radius: var(--gp-radius);
  overflow: hidden;
  box-shadow: none;
  display: grid;
  grid-template-rows: minmax(270px, 320px) auto;
  transition: box-shadow 0.3s;
}
.gp-cc-card:hover { box-shadow: none; }
.gp-cc-media { position: relative; min-height: 320px; background: linear-gradient(135deg,rgba(11,31,51,0.04),rgba(30,95,168,0.03)),#e9eaf0; overflow: hidden; }
.gp-cc-media img { width: 100%; height: 100%; object-fit: contain; display: block; padding: 4px; box-sizing: border-box; }
.gp-cc-content { padding: clamp(24px,2.6vw,34px); display: flex; flex-direction: column; gap: 16px; }
.gp-cc-content h3 { margin: 0; font-size: clamp(24px,2.5vw,32px); line-height: 1.15; font-weight: 700; }
.gp-cc-content p { margin: 0; max-width: 580px; font-size: clamp(15px,1.2vw,17px); line-height: 1.55; color: var(--gp-muted); }
.gp-cc-link { margin-top: 0; padding-top: 0; }
.gp-cc-link a { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 700; color: #E6B36A; text-decoration: none; transition: gap 0.2s; }
.gp-cc-link a:hover { gap: 10px; }
@media (max-width: 1024px) {
  .gp-cc-section { height: auto !important; }
  .gp-cc-sticky { position: relative; height: auto; overflow: visible; padding: 64px 0; }
  .gp-cc-header h2 { font-size: clamp(32px,7vw,40px); color: var(--color-h2); }
  .gp-cc-track { transform: none !important; flex-direction: column; }
  .gp-cc-card { flex: none; width: auto; min-height: auto; }
}
@media (max-width: 767px) {
  .gp-cc-card { grid-template-rows: auto auto; }
  .gp-cc-media { min-height: 240px; }
}
</style>
<script is:inline src="/hscroll.js"></script>
