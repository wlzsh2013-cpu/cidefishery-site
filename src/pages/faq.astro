---
import BaseLayout from "../layouts/BaseLayout.astro";

const faqs = [
  { q: "What are Artemia cysts used for?", a: "Artemia cysts (brine shrimp eggs) are primarily used as live feed for larval stages in shrimp hatcheries, fish fry programs, crab larvae hatcheries and other aquaculture operations worldwide." },
  { q: "Which product should I choose first?", a: "Start with your feeding method: Artemia cysts if you hatch live nauplii in-house, or decapsulated brine shrimp eggs if you need direct feeding. Share your species, volume, packaging and delivery schedule so we can recommend a current batch." },
  { q: "Can you provide current batch information before purchase?", a: "Yes. For qualified inquiries, we can discuss current batch hatchability, origin, packaging format, storage condition, MOQ and expected delivery timing before you confirm procurement." },
  { q: "How long can Artemia cysts be stored?", a: "When stored in cool, dry conditions away from direct sunlight, Artemia cysts can maintain viability for extended periods. We provide temperature-controlled cold chain storage and share specific storage guidance with every order." },
  { q: "Can Artemia cysts be shipped to any country?", a: "We export to major aquaculture markets across Asia, the Middle East, South America, and Africa. Contact our export team for specific destination and logistics inquiries." },
  { q: "What information helps you quote faster?", a: "Please send your product interest, destination country, target species, monthly usage volume, packaging preference, buyer type and expected purchase time. With those details, we can prepare a practical quote matched to your order requirements." },
];
---

<BaseLayout
  title="Artemia Cysts FAQ | Frequently Asked Questions | CIDE FISHERY"
  description="Frequently asked questions about Artemia cysts, brine shrimp eggs, packaging, storage, ordering and export supply from CIDE FISHERY."
  jsonLdType="FAQ"
  jsonLdData={{
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  }}
  breadcrumbs={[{ name: "FAQ", url: "/faq/" }]}
  showBreadcrumb={false}
>
  <section class="custom-faq-page">
    <div class="faq-container">
      <div class="faq-hero">
        <p class="faq-eyebrow">Support Center</p>
        <h1>Frequently Asked Questions</h1>
        <p>
          Find quick answers about Artemia cyst products, hatchery supply, packaging options, and export logistics.
        </p>
      </div>

      <div class="faq-layout">
        <div class="faq-left">
          {faqs.map((faq, i) => (
            <div class={`faq-item${i === 0 ? " active" : ""}`}>
              <button class="faq-question" type="button">
                <span>{faq.q}</span>
                <i></i>
              </button>
              <div class="faq-answer">
                <p>{faq.a}</p>
              </div>
            </div>
          ))}
        </div>

        <aside class="faq-contact">
          <div class="contact-card light">
            <span class="contact-label">Pre-sale inquiries?</span>
            <p class="contact-cta">Email us</p>
            <div class="contact-info">
              <small>E-mail</small>
              <a href="mailto:sales@cidefishery.com">sales@cidefishery.com</a>
            </div>
          </div>

          <div class="social-card">
            <span>Helpful links</span>
            <div class="social-links">
              <a href="/products/artemia-cysts/">Artemia Cysts</a>
              <a href="/products/decapsulated-eggs/">Decapsulated Eggs</a>
              <a href="/about/quality-control/">QC</a>
              <a href="/contact/">Quote</a>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .custom-faq-page {
    background: #F5F8FC;
    padding: 90px 20px 110px;
    color: #0B1F33;
    font-family: "Noto Sans", system-ui, -apple-system, sans-serif;
  }

  .custom-faq-page p {
    margin-bottom: 0;
  }

  .custom-faq-page a {
    color: inherit;
  }

  .custom-faq-page h1 {
    font-family: "IBM Plex Sans", system-ui, -apple-system, sans-serif;
    margin: 0;
    line-height: 0.95;
  }

  .custom-faq-page h3 {
    font-family: "IBM Plex Sans", system-ui, -apple-system, sans-serif;
    margin: 0;
  }

  .faq-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  .faq-hero {
    max-width: 760px;
    margin-bottom: 58px;
  }

  .faq-eyebrow {
    margin: 0 0 14px;
    color: #E6B36A;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .faq-hero h1 {
    font-size: clamp(44px, 7vw, 58px);
    letter-spacing: -0.06em;
    font-weight: 800;
    color: #1E5FA8;
  }

  .faq-hero p {
    max-width: 560px;
    margin: 24px 0 0;
    color: #102030;
    font-size: 18px;
    line-height: 1.7;
  }

  .faq-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 360px;
    gap: 48px;
    align-items: start;
  }

  .faq-left {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .faq-item {
    background: #fff;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 14px 38px rgba(11, 31, 51, 0.04);
  }

  .faq-question {
    width: 100%;
    border: 0;
    background: transparent;
    padding: 26px 28px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    cursor: pointer;
    text-align: left;
    color: #0B1F33;
    font-size: 20px;
    line-height: 1.35;
    font-weight: 700;
    font-family: "Noto Sans", system-ui, -apple-system, sans-serif;
  }

  .faq-question i {
    position: relative;
    flex: 0 0 34px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: rgba(11, 31, 51, 0.06);
    transition: background 0.25s ease;
  }

  .faq-question i::before,
  .faq-question i::after {
    content: "";
    position: absolute;
    background: #0B1F33;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    border-radius: 2px;
  }

  .faq-question i::before {
    width: 14px;
    height: 2px;
  }

  .faq-question i::after {
    width: 2px;
    height: 14px;
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }

  .faq-answer p {
    margin: 0;
    padding: 0 28px 28px;
    color: #102030;
    font-size: 16px;
    line-height: 1.8;
  }

  .faq-item.active .faq-answer {
    max-height: 260px;
  }

  .faq-item.active .faq-question i {
    background: #0B1F33;
  }

  .faq-item.active .faq-question i::before,
  .faq-item.active .faq-question i::after {
    background: #fff;
  }

  .faq-item.active .faq-question i::after {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq-contact {
    position: sticky;
    top: 30px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .contact-card,
  .social-card {
    border-radius: 28px;
    padding: 30px;
  }

  .contact-card a {
    color: inherit;
    text-decoration: none;
  }

  .contact-card.dark {
    background: #0B1F33;
    color: #fff;
  }

  .contact-card.light {
      background: #E9C187;
      color: #fff;
  }

  .contact-label,
  .social-card > span {
    display: block;
    margin-bottom: 10px;
    font-size: 14px;
    font-weight: 700;
    color: #E6B36A;
  }

  .contact-card.dark .contact-label {
    color: rgba(233, 193, 135, 0.8);
  }

    .contact-card.light .contact-label {
      color: #3A4B5B;
    }

    .contact-card.light .contact-cta {
      color: #0B1F33;
    }

  .contact-card h3 {
    margin-bottom: 28px;
    font-size: 32px;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

    .contact-cta {
      padding-bottom: 28px;
      font-size: 32px;
      line-height: 1.05;
      letter-spacing: -0.04em;
      font-weight: 800;
      color: #E9C187;
      font-family: 'IBM Plex Sans', system-ui, -apple-system, sans-serif;
    }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contact-info small {
    color: inherit;
    opacity: 0.65;
    font-size: 13px;
  }

  .contact-info a {
    color: inherit;
    text-decoration: none;
    font-size: 18px;
    font-weight: 800;
  }

  .contact-info a:hover {
    text-decoration: underline;
  }

  .social-card {
    background: #fff;
    }

  .social-card > span {
    color: #E6B36A;
  }

  .social-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 18px;
  }

  .social-links a {
    min-height: 40px;
    padding: 9px 14px;
    border-radius: 999px;
    background: rgba(11, 31, 51, 0.08);
    color: rgba(11, 31, 51, 0.55);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-size: 13px;
    font-weight: 800;
    transition: background 0.25s ease, transform 0.25s ease;
  }

  .social-links a svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .social-links a:hover {
    transform: translateY(-3px);
    background: #E6B36A;
  }

  @media (max-width: 960px) {
    .custom-faq-page {
      padding: 70px 18px 80px;
    }

    .faq-layout {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .faq-contact {
      position: static;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }

    .social-card {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .faq-contact {
      grid-template-columns: 1fr;
    }

    .social-card {
      grid-column: auto;
    }

    .faq-question {
      padding: 22px;
      font-size: 18px;
    }

    .faq-answer p {
      padding: 0 22px 24px;
    }
  }
</style>

<script>
  (function() {
    var handleClick = function() {
      var item = this.closest(".faq-item");
      var faqGroup = this.closest(".faq-left");

      faqGroup.querySelectorAll(".faq-item").forEach(function(faq) {
        if (faq !== item) faq.classList.remove("active");
      });

      item.classList.toggle("active");
    };

    document.querySelectorAll(".custom-faq-page .faq-question").forEach(function(button) {
      button.addEventListener("click", handleClick);
    });
  })();
</script>
