---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import CTASection from '../../components/CTASection.astro';

const products = [
  {
    title: 'Artemia Cysts',
    href: '/products/artemia-cysts/',
    image: '/images/products/cide-artemia-cysts-gold-can.jpg',
    width: 425,
    height: 425,
    alt: 'CIDE Artemia cysts canned product packaging',
    desc: 'Natural brine shrimp eggs for hatcheries and distributors, with batch hatchability checks, origin records, cold-chain storage and flexible packaging.',
    fit: 'Hatcheries, importers and distributors seeking dependable daily larval feeding supply with clear batch documents and procurement support.',
    tag: 'Artemia Cysts',
    cta: 'View Artemia Cysts',
    ctaBatch: 'Get Artemia Batch Analysis',
    metrics: [
      { label: 'Hatchability', value: '80-90%' },
      { label: 'Packaging', value: '425g / 15oz can' },
      { label: 'MOQ', value: '100 kg reference' },
      { label: 'Species', value: 'Shrimp PL / fish fry' },
    ],
  },
  {
    title: 'Decapsulated Brine Shrimp Eggs',
    href: '/products/decapsulated-eggs/',
    image: '/images/decapsulated-brine-shrimp-eggs.avif',
    width: 1448,
    height: 1086,
    alt: 'Decapsulated Brine Shrimp Eggs',
    desc: 'Shell-removed brine shrimp eggs for direct feeding, designed to reduce hatching labor, improve cleanliness and support sensitive fry programs.',
    fit: 'Fish fry producers and nurseries that need shell-free feed, better energy intake and simpler daily feeding operations.',
    tag: 'Decapsulated Brine Shrimp Eggs',
    cta: 'View Decapsulated Eggs',
    ctaBatch: 'Request Product Details',
    metrics: [
      { label: 'Type', value: 'Direct feeding' },
      { label: 'Purity', value: '95%+ reference' },
      { label: 'Packaging', value: 'Foil bag / carton' },
      { label: 'Species', value: 'Fish fry / crab larvae' },
    ],
  },
];

const buyerRoutes = [
  { type: 'Hatchery', need: 'Recommended grade, current batch hatchability, target species fit, MOQ and feeding schedule support.', href: '/contact/?buyer=hatchery', icon: '/icons/shrimp-hatcheries.svg', alt: 'Shrimp hatchery Artemia cyst product recommendation icon' },
  { type: 'Distributor', need: 'Origin, packaging, cold-chain records, export documents and repeatable batch supply planning.', href: '/contact/?buyer=distributor', icon: '/icons/importers-distributors.svg', alt: 'Aquaculture importer and distributor bulk supply recommendation icon' },
  { type: 'Bulk / Private Label', need: 'Custom cans, foil bags, drums, label artwork, container planning and delivery schedule options.', href: '/contact/?buyer=private-label', icon: '/icons/export-packaging.svg', alt: 'Private label Artemia cyst packaging recommendation icon' },
];
---

<BaseLayout
  title="Artemia Cysts and Decapsulated Eggs for Aquaculture | CIDE FISHERY"
  description="Compare Artemia cysts and decapsulated brine shrimp eggs for hatcheries, fry producers, distributors and private-label aquaculture procurement."
  ogImage="/images/products/artemia-cysts-hero.jpg"
  breadcrumbs={[{ name: 'Products', url: '/products/' }]}
  showBreadcrumb
>
  <div class="products-page">
  <section class="products-hero section bg-light">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">AQUACULTURE FEED PROCUREMENT</span>
        <h1>Choose Between Artemia Cysts and Decapsulated Eggs</h1>
        <p class="page-lead">Choose the feed format that matches your hatchery workflow: hatch live nauplii from Artemia cysts, or feed shell-free decapsulated eggs directly. We can confirm current batch specs, origin, packaging, MOQ and delivery timing for your order.</p>
        <div class="hero-ctas">
          <Button href="/contact/" variant="primary" size="lg">Get a Quick Quote</Button>
          <Button href="/about/quality-control/" variant="outline" size="lg">View QC Capability</Button>
        </div>
      </div>
      <div class="hero-media">
        <img src="/images/products/cide-artemia-cysts-blue-can.jpg" alt="CIDE Artemia cysts blue can packaging for aquaculture supply" width="425" height="425" loading="eager" />
      </div>
    </div>
  </section>

  <section class="cide-product-stack" data-cide-product-stack>
    <div class="cide-product-stack-inner">
      <div class="cide-product-stack-header cide-stack-reveal">
        <div>
          <span class="eyebrow">Product categories</span>
          <h2>Two Product Categories, Clear Procurement Documents</h2>
        </div>

        <div class="cide-product-stack-intro">
          <p>Every quote can be tied to current batch information, product photos, packaging format, cold-storage condition, MOQ and expected purchase time.</p>
          <a href="/contact/">Request recommendation</a>
        </div>
      </div>

      <div class="cide-stack-cards">
        {products.map((product, index) => (
          <article class={`cide-stack-card cide-stack-card-0${index + 1} cide-stack-reveal`} data-stack-card>
            <div class="cide-stack-copy">
              <span>{String(index + 1).padStart(2, '0')} / {product.tag}</span>
              <h3>{product.title}</h3>
              <p>{product.desc}</p>
              <div class="cide-stack-fit"><strong>Ideal For:</strong> {product.fit}</div>
              <div class="product-mini-metrics">
                {product.metrics.map((metric) => (
                  <span><strong>{metric.label}</strong>{metric.value}</span>
                ))}
              </div>
              <a class="product-batch-link" href={`/contact/?product=${encodeURIComponent(product.tag)}`}>{product.ctaBatch}</a>
              <a class="cide-stack-link" href={product.href}>{product.cta}</a>
            </div>

            <a class="cide-stack-media" href={product.href} aria-label={`View ${product.title}`}>
              <img src={product.image} alt={product.alt} width={product.width} height={product.height} loading="lazy" />
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-light product-guide-section">
    <div class="container compare-wrap">
      <div>
        <span class="eyebrow">Procurement guide</span>
        <h2>Which Product Fits Your Current Aquaculture Setup?</h2>
        <p>Choose by target species, daily labor model and order scale. Artemia cysts support live nauplii hatching programs, while decapsulated eggs simplify direct feeding and tank cleanliness. For larger orders, we can include MOQ, packaging, private-label and delivery planning in the quote.</p>
      </div>
      <div class="buyer-list">
        {buyerRoutes.map((item) => (
          <a class="buyer-item" href={item.href}>
            <img class="buyer-icon" src={item.icon} alt={item.alt} width="52" height="52" loading="lazy" decoding="async" />
            <span class="buyer-copy"><h3>{item.type}</h3><small>{item.need}</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container package-band">
      <div>
        <span class="eyebrow">PACKAGING &amp; COLD-CHAIN LOGISTICS</span>
        <h2>Industrial-Grade Vacuum Cans, Foil Bags &amp; Customized Bulk Packaging</h2>
        <p>To protect hatchability during transit, CIDE FISHERY uses moisture-proof vacuum cans, heavy-duty foil bags and protective outer drums. We provide private labeling options and cold-storage container coordination for reliable arrival at your port.</p>
        <div class="hero-ctas">
          <Button href="/about/packaging/" variant="primary" size="lg">Review Packaging Specs</Button>
          <Button href="/about/cold-storage/" variant="outline" size="lg">Learn About Our Cold Chain</Button>
        </div>
      </div>
      <img src="/images/products/artemia-cysts-foil-bag-packaging.avif" alt="Artemia cysts foil bag packaging for cold-chain supply." width="1448" height="1086" loading="lazy" />
    </div>
  </section>
</div>
  <CTASection
    title="Need a Supply Quote?"
    description="Send your product, species, volume, packaging and destination details to receive a practical supply proposal."
    ctaText="Request Quote"
    ctaHref="/contact/"
    showInquiryForm
  />

</BaseLayout>

<script>
(function () {
  const section = document.querySelector('[data-cide-product-stack]');
  if (!section) return;

  const revealEls = Array.from(section.querySelectorAll('.cide-stack-reveal'));
  const cards = Array.from(section.querySelectorAll('[data-stack-card]'));

  function clamp(value, min, max) {
    return Math.min(Math.max(value, min), max);
  }

  const observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('is-visible');
      }
    });
  }, {
    threshold: 0.18,
    rootMargin: '0px 0px -8% 0px'
  });

  revealEls.forEach(function (el) {
    observer.observe(el);
  });

  function updateStackMotion() {
    const windowH = window.innerHeight || 1;

    cards.forEach(function (card, index) {
      const media = card.querySelector('.cide-stack-media');
      if (!media) return;

      const rect = card.getBoundingClientRect();
      const progress = clamp((windowH - rect.top) / (windowH + rect.height), 0, 1);
      const centered = progress - 0.5;
      const strength = index % 2 === 0 ? 22 : -22;
      const y = centered * strength;

      media.style.setProperty('--media-y', y.toFixed(2) + 'px');
    });
  }

  let ticking = false;

  function requestMotion() {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(function () {
      updateStackMotion();
      ticking = false;
    });
  }

  window.addEventListener('scroll', requestMotion, { passive: true });
  window.addEventListener('resize', requestMotion);
  updateStackMotion();
})();
</script>


