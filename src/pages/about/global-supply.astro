---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';

const network = [
  {
    icon: '/icons/china-saline-lake-network.svg',
    alt: 'China saline lake raw material network icon for Artemia cyst sourcing coverage',
    title: 'China Raw Material Network',
    desc: 'Source Artemia cysts from verified harvest channels in China, including Xinjiang, Inner Mongolia, Tibet and Bohai Bay regions.',
  },
  {
    icon: '/icons/stable-international-cooperation.svg',
    alt: 'Stable international cooperation handshake icon for Artemia cyst supply partnerships',
    title: 'Stable International Cooperation',
    desc: 'Use direct raw-material cooperation in Russia and Kazakhstan to support repeat supply planning beyond a single harvest area.',
  },
  {
    icon: '/icons/strategic-uzbekistan-development.svg',
    alt: 'Strategic Uzbekistan development infrastructure icon for Aral Sea Artemia sourcing operations',
    title: 'Strategic Uzbekistan Development',
    desc: 'Add Aral Sea basin sourcing and processing cooperation when your order plan needs more volume options.',
  },
  {
    icon: '/icons/proven-global-export-footprint.svg',
    alt: 'Proven global export footprint logistics icon for Artemia cyst cargo delivery',
    title: 'Proven Global Export Footprint',
    desc: 'Arrange Artemia cyst cargo with export documents, packaging formats and logistics planning for major aquaculture markets.',
  },
];

const buyerRoutes = [
  'Commercial Hatcheries: Plan monthly Artemia cyst and decapsulated egg supply around daily larval feeding windows.',
  'Wholesale Importers: Compare processing capacity, batch documents and export packaging before placing bulk orders.',
  'Regional Distributors: Plan buffer stock, resale labels and recurring sea freight schedules for your local market.',
  'Enterprise Aquaculture Groups: Coordinate raw sourcing, quality control, cold storage and shipping through one supply partner.'
];
---
<BaseLayout
  title="Global Artemia Cyst Supply Network | CIDE FISHERY"
  description="Plan Artemia cyst raw sourcing, refining, cold storage, export documents and global delivery with CIDE FISHERY."
  ogImage="/images/company/cide-fishery-aquaculture-campus-aerial-view.avif"
  breadcrumbs={[{ name: 'About', url: '/about/' }, { name: 'Global Supply', url: '/about/global-supply/' }]}
  showBreadcrumb
>
  <section class="section page-header bg-light"><div class="container hero-grid"><div><span class="eyebrow">GLOBAL SUPPLY NETWORK</span><h1>Artemia Cyst Supply from Raw Sourcing to Global Delivery</h1><p class="page-lead">Use one supply partner for raw material sourcing, refining, cold storage, export documents and delivery planning. CIDE FISHERY supports hatcheries, importers and distributors that need repeat Artemia cyst supply with clear batch information.</p><div class="hero-ctas"><Button href="/contact/" variant="primary" size="lg">Plan a Supply Program</Button><Button href="/products/artemia-cysts/" variant="outline" size="lg">Artemia Cysts</Button></div></div><img src="/images/company/cide-fishery-aquaculture-campus-aerial-view.avif" alt="CIDE FISHERY campus aerial view" width="1200" height="755" loading="eager" /></div></section>
  <section class="section bg-light sourcing-section"><div class="container"><div class="section-head"><span class="eyebrow">SOURCING COVERAGE</span><h2>Compare Supply Sources Before You Plan Repeat Orders</h2><p>For commercial hatchery supply, raw material origin and harvest allocation affect volume, lead time and batch planning. Review the sourcing network behind your Artemia cyst order before you commit to a long-term program.</p></div><div class="workflow-grid">{network.map((f)=>(<article class="workflow-card"><img class="workflow-icon" src={f.icon} alt={f.alt} width="58" height="58" loading="lazy" decoding="async" /><h3>{f.title}</h3><p>{f.desc}</p></article>))}</div></div></section>
  <section class="section bg-light"><div class="container media-band"><img src="/images/company/cide-fishery-global-supply-meeting-room.avif" alt="CIDE FISHERY meeting room" width="1200" height="801" loading="lazy" /><div><span class="eyebrow">B2B BUYER FIT</span><h2>Choose the Supply Setup That Matches Your Order Scale</h2><p>Tell us your product, destination, order volume and packaging requirement. We can prepare the batch details, documents and shipment plan needed for:</p><ul>{buyerRoutes.map((item)=>(<li>{item}</li>))}</ul></div></div></section>
</BaseLayout>
<style>.page-header{padding:64px 0}.hero-grid,.media-band{display:grid;grid-template-columns:1fr 1fr;gap:48px;align-items:center}.hero-grid img,.media-band img{width:100%;aspect-ratio:4/3;object-fit:cover;border:1px solid var(--color-neutral-gray);border-radius:var(--border-radius);background:var(--color-white)}.eyebrow{display:inline-block;color:var(--color-brand-blue);font-size:13px;font-weight:700;text-transform:uppercase;margin-bottom:10px}.page-lead{font-size:18px;opacity:.84;margin:16px 0 24px}.hero-ctas{display:flex;gap:16px;flex-wrap:wrap}.section-head{max-width:820px;margin-bottom:30px}.section-head p{margin:20px 0 0}.media-band h2+p{margin-top:20px}.workflow-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.workflow-card{display:block;min-height:260px;border:1px solid var(--color-neutral-gray);border-radius:var(--border-radius);padding:24px;background:var(--color-white);color:var(--color-text)}.workflow-card :global(.workflow-icon){display:flex;width:58px;height:58px;margin-bottom:0;align-items:center;justify-content:center}.workflow-card h3{font-size:20px;font-weight:800;color:var(--color-primary);margin:22px 0 0}.workflow-card p{margin-top:10px;font-size:var(--fs-small);line-height:1.6;opacity:.78}.media-band ul{padding-left:20px;margin-top:18px}.media-band li{margin-bottom:10px}@media(max-width:1024px){.hero-grid,.media-band{grid-template-columns:1fr}.workflow-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:767px){.workflow-grid{grid-template-columns:1fr}}</style>
